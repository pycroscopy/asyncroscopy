import DigitalMicrograph as DM
import Pyro5.api
import numpy as np

@Pyro5.api.expose
class EELSServer:
    def check_server(self):
        return f"EELS Pyro5 1 server running."

    def check_data(self, length):
        return np.arange(length).tolist()

    def set_eels_offset(self, offset):
        DM.ExecuteScriptString(f"EELSSetStartEnergy({offset:.3f})")
        return f"EELS {offset}"
    
    def initialize_eels(self):
        """ initialize Gatan Image Filter to EELS mode if Image Filter is available""" 
        command = "number defaultFilterPresent=0.0 \n"
        command += "setpersistentnumbernote(\"EELSserver:DefaultValues:FilterPresent\",defaultFilterPresent)\n"
        command += "defaultFilterPresent = IFVerifyCommunication( ) \n"
        command += "setpersistentnumbernote(\"EELSserver:DefaultValues:FilterPresent\",defaultFilterPresent)\n"
        command += "if (defaultFilterPresent==1) (IFSetSpectroscopyMode( ))"
        DM.ExecuteScriptString( command )
        globalTags = DM.GetPersistentTagGroup()
        success, self.filterPpresent = globalTags.GetTagAsString("EELSserver:DefaultValues:FilterPresent")

    def get_eels_spectrum(self, exposure_time, number_of_frames=1):
        """Get EELS spectrum with energy_scale offset and dispersion"""
        command = f"image spectrum := EELSAcquireSpectrum({exposure_time}, {number_of_frames}, 1, 1, 2 )\n"
        command += "spectrum.ShowImage()"
        DM.ExecuteScriptString( command )
        myImage = DM.FindFrontImage()
        offset = myImage.GetDimensionOrigin(0)
        dispersion = myImage.GetDimensionScale(0)
        spectrum = myImage.GetNumArray().tolist()
        DM.DeleteImage(myImage)
        return spectrum, offset, dispersion

    def get_available_dispersions(self):    
        """ Get available dispersion settrings with indices from Gatan Image Filter """
        command = "number nDisp = IFGetNumberOfDispersions( ) \nstring message = \"\" \n"
        command += "for ( number i = 0; i < nDisp; i++ )\n{message +=  i + \": \" + IFGetDispersion( i )+\", \" \n} \n"
        command += "setpersistentstringnote(\"EELSserver:DefaultValues:availableDispersions\", message)"

        DM.ExecuteScriptString( command )
        globalTags = DM.GetPersistentTagGroup()
        success, self.available_dispersions = globalTags.GetTagAsString("EELSserver:DefaultValues:availableDispersions")
        return self.available_dispersions
        
    def get_eels_dispersion(self):
        """ Get current EELS dispersion setting"""
        command = "setpersistentnumbernote(\"EELSserver:DefaultValues:currentDiapersionIndex\",IFGetActiveDispersionIndex())\n"
        command += "setpersistentstringnote(\"EELSserver:DefaultValues:currentDiapersion\",IFGetActiveDispersion())"
        DM.ExecuteScriptString( command )
        globalTags = DM.GetPersistentTagGroup()
        success, dispersion_index = globalTags.GetTagAsString("EELSserver:DefaultValues:currentDiapersionIndex")
        success, dispersion = globalTags.GetTagAsString("EELSserver:DefaultValues:currentDiapersion")
        return dispersion_index, dispersion
    
    def set_eels_dispersion(self, dispersion_index):
        """Set EELS dispersion through dispersion_index"""
        if isinstance(dispersion_index, int):
            command = f"IFSetActiveDispersionIndex( {dispersion_index} )\n"
            command += "IFWaitForFilter( )"
            DM.ExecuteScriptString( command )

    def get_eels_aperture(self):
        """Get EELS entrance aperture name and index"""
        command = "number aperture_index = IFGetActiveAperture()\n"
        command += "setpersistentnumbernote(\"EELSserver:DefaultValues:currentApertureIndex\",aperture_index)\n"
        command += "setpersistentstringnote(\"EELSserver:DefaultValues:currentAperture\",IFGetApertureLabel(aperture_index))"
        DM.ExecuteScriptString( command )
        globalTags = DM.GetPersistentTagGroup()
        success, aperture = globalTags.GetTagAsString("EELSserver:DefaultValues:currentAperture")
        success, aperture_index = globalTags.GetTagAsString("EELSserver:DefaultValues:currentApertureIndex")
        return aperture

    def set_eels_aperture(self, aperture_index):
        """Set EELS entrance aperature with index"""
        if isinstance(aperture_index, int):
                command = f"IFSetActiveAperture( {aperture_index} )\n"
                command += "IFWaitForFilter( )"
                DM.ExecuteScriptString(command)

    def get_available_apertures(self):
        """ Get all available EELS entranc aperture names and indices """
        command = "number nAp = IFGetNumberOfApertures( ) \nstring message = \"\" \n"
        command += "for ( number i = 0; i < nAp; i++ )\n{message +=  i + \": \" + IFGetApertureLabel( i )+\", \" \n} \n"
        command += "setpersistentstringnote(\"EELSserver:DefaultValues:availableApertures\", message)"
        DM.ExecuteScriptString( command )
        globalTags = DM.GetPersistentTagGroup()
        success, self.available_apertures = globalTags.GetTagAsString("EELSserver:DefaultValues:availableApertures")
        return str(self.available_apertures)


def main():
    # Manually set the host IP and port here
    HOST_IP = "10.46.217.242"  # Or your network IP like "192.168.1.50"
    PORT = 9091

    daemon = Pyro5.server.Daemon(host=HOST_IP, port=PORT)

    # Custom objectId creates a clean, predictable URI
    uri = daemon.register(EELSServer, objectId="eels_server")

    print("Server is running...")
    print("Object URI =", uri)
    daemon.requestLoop()

if __name__ == "__main__":
    main()
